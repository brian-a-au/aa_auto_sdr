# aa_auto_sdr — Environment Variables
# Copy to .env in the working directory and fill in. The tool reads this file
# on every install. It does not search parent folders.

# Adobe OAuth Server-to-Server (Required)
ORG_ID=your_org_id@AdobeOrg
CLIENT_ID=your_client_id
SECRET=your_client_secret
SCOPES=your_scopes_from_developer_console

# Optional
# SANDBOX=your_sandbox_name
# LOG_LEVEL=INFO

# Default profile. Set AA_PROFILE in your shell, e.g. `export AA_PROFILE=production`.
# The --profile flag beats AA_PROFILE. The credential lookup does not read
# AA_PROFILE from this file.
# AA_PROFILE=production
